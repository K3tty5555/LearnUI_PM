      "html": "<button class=\"ds-button-primary\">开始浏览</button>",
      "css": ".ds-button-primary{font-family:var(--font-sans,Geist,sans-serif);font-size:12px;cursor:pointer;transition:background-color 120ms var(--ease-out,cubic-bezier(.23,1,.32,1)),border-color 120ms var(--ease-out,cubic-bezier(.23,1,.32,1)),transform 60ms var(--ease-out,cubic-bezier(.23,1,.32,1));display:inline-flex;align-items:center;border:1px solid transparent;border-radius:8px;padding:0 18px;height:44px;background:var(--blue,#242428);color:#fff;}.ds-button-primary:hover{background:#3b3b43;}.ds-button-primary:focus-visible{outline:2px solid var(--blue,#242428);outline-offset:4px}.ds-button-primary:active{transform:scale(.97)}.ds-button-primary:disabled{opacity:.45;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-button-primary{transition-duration:.01ms!important;animation:none!important}}"
