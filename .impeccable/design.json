      "css": ".ds-tag{display:inline-block;padding:3px 7px;border-radius:4px;background:#ededf2;color:var(--gray-600,#575760);font:10px var(--font-sans,Geist,sans-serif)}@media(prefers-reduced-motion:reduce){.ds-tag{transition-duration:.01ms!important;animation:none!important}}"
    },
    {
