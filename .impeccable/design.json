      "html": "<nav class=\"ds-nav\" aria-label=\"参考栏目\"><a href=\"#ui\" aria-current=\"page\">UI 元素 <span>62</span></a><a href=\"#pages\">页面参考 <span>12</span></a></nav>",
      "css": ".ds-nav{display:grid;gap:5px;font-family:var(--font-sans,Geist,sans-serif)}.ds-nav a{display:flex;align-items:center;gap:11px;min-height:45px;padding:0 12px;border-radius:8px;color:var(--gray-600,#575760);font-size:13px;text-decoration:none}.ds-nav span{margin-left:auto;font:11px var(--font-mono,monospace);color:var(--gray-500,#666670)}.ds-nav a:hover{background:#e7e7ed}.ds-nav a[aria-current]{background:var(--accent,#e1e1e7);color:#242428;font-weight:600}.ds-nav a:focus-visible{outline:2px solid var(--blue,#242428);outline-offset:4px}@media(prefers-reduced-motion:reduce){.ds-nav{transition-duration:.01ms!important;animation:none!important}}"
    },
    {
