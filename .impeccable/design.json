      "description": "白色搜索框，森林绿焦点边框。",
      "html": "<label class=\"ds-search\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" aria-hidden=\"true\"><circle cx=\"10.5\" cy=\"10.5\" r=\"6.5\"/><path d=\"m16 16 5 5\"/></svg><input type=\"search\" aria-label=\"搜索组件\" placeholder=\"搜索组件名称…\"></label>",
      "css": ".ds-search{display:flex;align-items:center;gap:8px;height:44px;padding:0 12px;border:1px solid var(--line,#dddde3);border-radius:8px;background:#fff;color:var(--gray-400,#696973);transition:background-color 120ms var(--ease-out,cubic-bezier(.23,1,.32,1)),border-color 120ms var(--ease-out,cubic-bezier(.23,1,.32,1)),transform 60ms var(--ease-out,cubic-bezier(.23,1,.32,1));}.ds-search:hover{border-color:var(--line-strong,#bcbcc5)}.ds-search:focus-within{border-color:var(--blue,#242428)}.ds-search input{font-family:var(--font-sans,Geist,sans-serif);font-size:12px;cursor:pointer;min-width:0;width:100%;border:0;background:transparent;color:var(--fg,#242428);outline:none}@media(prefers-reduced-motion:reduce){.ds-search{transition-duration:.01ms!important;animation:none!important}}"
    },
