      "html": "<div class=\"ds-filters\" role=\"group\" aria-label=\"平台\"><button aria-pressed=\"true\">全部</button><button aria-pressed=\"false\">Web</button></div>",
      "css": ".ds-filters{display:flex;gap:2px;height:40px;padding:3px;background:#ebebf0;border-radius:7px}.ds-filters button{font-family:var(--font-sans,Geist,sans-serif);font-size:12px;cursor:pointer;transition:background-color 120ms var(--ease-out,cubic-bezier(.23,1,.32,1)),border-color 120ms var(--ease-out,cubic-bezier(.23,1,.32,1)),transform 60ms var(--ease-out,cubic-bezier(.23,1,.32,1));border:0;border-radius:5px;background:transparent;color:var(--gray-600,#575760);padding:0 12px;font-size:11px}.ds-filters button:hover{background:var(--fill,#e9e9ed)}.ds-filters button[aria-pressed=true]{background:white;color:var(--fg,#242428)}.ds-filters button:focus-visible{outline:2px solid var(--blue,#242428);outline-offset:4px}@media(prefers-reduced-motion:reduce){.ds-filters{transition-duration:.01ms!important;animation:none!important}}"
    },
